# Copy this file to ".env" (same folder) and fill in the values.
# Never commit the real .env file.

# ---------- Server ----------
PORT=4000

# ---------- MongoDB ----------
# Local MongoDB:  mongodb://127.0.0.1:27017/outlook-mail
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/outlook-mail?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/outlook-mail

# ---------- Microsoft Entra (Azure) app registration ----------
# "Application (client) ID" from the app's Overview page
AZURE_CLIENT_ID=paste-your-application-client-id-here
# "consumers" = personal Microsoft accounts (outlook.com / hotmail.com / live.com)
AZURE_AUTHORITY=https://login.microsoftonline.com/consumers

# ---------- Mailbox ----------
# The Outlook address whose mail you want to see. "npm run connect" refuses any other account.
MAILBOX_ADDRESS=address@outlook.com
